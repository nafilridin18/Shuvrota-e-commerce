# Uploaded files (product images, videos, banners) must NEVER execute as code,
# even if someone manages to upload a disguised .php file.
<FilesMatch "\.(php|php\d?|phtml|pl|py|cgi|sh)$">
    Require all denied
</FilesMatch>

Options -ExecCGI

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

